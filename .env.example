# ---- Database ----
# SQLite (default, zero-setup):  leave DATABASE_URL unset -> sqlite:///./drishti.db
# PostgreSQL (production/local):
DATABASE_URL=postgresql+psycopg2://drishti:drishti@localhost:5432/drishti

# ---- data.gov.in Open Data API (REAL connector) ----
# Get a free key at https://data.gov.in  (used as ?api-key=...)
DATAGOVIN_API_KEY=

# ---- e-SAKSHI (only if/when an official API is documented) ----
# Live e-SAKSHI API is NOT verified; leave blank and use official export/import.
ESAKSHI_API_BASE=
ESAKSHI_API_TOKEN=

# ---- Frontend ----
VITE_API_BASE=http://localhost:8000
CORS_ORIGINS=*
